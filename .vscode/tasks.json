{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Current Animation File",
      "type": "shell",
      "command": "python",
      "args": [
        "${relativeFile}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
